generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Location {
  id String @id @default(cuid())
  name String @unique
  parentId String?
  items Item[]
}
model Item {
  id String @id @default(cuid())
  name String
  normalizedName String
  brand String @default("")
  quantity Float
  unit String
  category String
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  notes String @default("")
  storage String @default("")
  leftover Boolean @default(false)
  status String @default("available")
  expiration String
  dateSource String
  datePrecision String
  dateKind String @default("quality")
  confidence Float
  source String
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Processing {
  id String @id @default(cuid())
  requestId String @unique
  original String
  promptVersion String
  model String
  result String?
  status String @default("processing")
  baseRevision Int
  createdAt DateTime @default(now())
  events Event[]
  uploads Upload[]
}
model Event {
  id String @id @default(cuid())
  processingId String
  processing Processing @relation(fields: [processingId], references: [id])
  itemId String
  action String
  before String?
  after String?
  validation String @default("accepted")
  undone Boolean @default(false)
  createdAt DateTime @default(now())
}
model Message {
  id String @id @default(cuid())
  role String
  content String
  processingId String?
  createdAt DateTime @default(now())
}
model Upload {
  id String @id @default(cuid())
  processingId String
  processing Processing @relation(fields: [processingId], references: [id])
  path String
  mime String
  deleted Boolean @default(false)
  createdAt DateTime @default(now())
}
model DebugLog {
  id String @id @default(cuid())
  code String
  processingId String?
  createdAt DateTime @default(now())
}
model Setting {
  key String @id
  value String
}
model Session {
  id String @id
  scope String @default("nora")
  createdAt DateTime @default(now())
  lastSeen DateTime @default(now())
  @@index([scope])
}
model LoginAttempt {
  id Int @id @default(1)
  failures Int @default(0)
  blockedUntil DateTime?
}
model ExternalUsage {
  provider String
  period String
  count Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([provider, period])
}

model MenuGeneration {
  id String @id @default(cuid())
  status String @default("active")
  source String
  inventoryRevision Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dishes MenuDish[]
  @@index([status, createdAt])
}

model MenuDish {
  id String @id @default(cuid())
  generationId String
  generation MenuGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  position Int
  nameZh String
  nameEn String
  prepMinutes Int
  cookMinutes Int
  imageSearchQuery String
  ingredientsJson String
  stepsZhJson String
  stepsEnJson String
  requiredItemIdsJson String
  useSoon Boolean @default(false)
  imageId String?
  imageStatus String @default("queued")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([generationId, position])
  @@index([generationId, position])
}

model MenuImage {
  id String @id @default(cuid())
  normalizedDish String
  candidateIndex Int
  title String
  pageUrl String
  imageUrl String
  source String
  path String
  mime String
  size Int
  preferred Boolean @default(false)
  selected Boolean @default(false)
  disliked Boolean @default(false)
  lastUsedAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@unique([normalizedDish, candidateIndex])
  @@index([normalizedDish, preferred, disliked])
  @@index([lastUsedAt])
}

model MenuJob {
  id String @id @default(cuid())
  type String
  status String @default("queued")
  priority Int @default(0)
  generationId String?
  dishId String?
  stage Int @default(0)
  stateJson String?
  attempts Int @default(0)
  notBefore DateTime @default(now())
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, notBefore, priority])
  @@index([generationId])
  @@index([dishId])
}
